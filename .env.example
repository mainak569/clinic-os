# Copy to .env (Prisma's CLI and the seed script read .env; Next.js reads it too):
#   cp .env.example .env

# ============================================================================
# DATABASE (required)
# ============================================================================
# Supabase transaction pooler, used by the app
DATABASE_URL="postgresql://username:password@host:6543/postgres?pgbouncer=true"

# Direct connection, used by Prisma migrations (bypasses the pooler)
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# ============================================================================
# AUTHENTICATION (required)
# ============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# The app's own URL (https://your-app.vercel.app in production)
AUTH_URL="http://localhost:3000"

# ============================================================================
# CLINIC TIMEZONE (required in production)
# ============================================================================
# IANA timezone. Availability slots are wall-clock times in this zone, and
# appointments are compared against them on this clock. Defaults to
# Asia/Kolkata. Set it explicitly on Vercel and any other host running in UTC.
CLINIC_TIMEZONE="Asia/Kolkata"
# Optional: the same value, exposed to the browser at build time.
# NEXT_PUBLIC_CLINIC_TIMEZONE="Asia/Kolkata"

# ============================================================================
# CRON (required in production)
# ============================================================================
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/generate-alerts.
# The endpoint refuses all requests in production when this is unset.
# Generate with: openssl rand -base64 32
# CRON_SECRET="your-cron-secret-here"

# ============================================================================
# OPTIONAL: ERROR TRACKING (SENTRY)
# ============================================================================
# The Sentry config files read these, but Sentry is not initialised by the app
# yet (there is no instrumentation.ts), so setting them has no effect today.
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
