# ============================================================================
# DATABASE
# ============================================================================
# Supabase PostgreSQL connection strings
# For production with connection pooling:
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true&schema=public"

# Direct database URL for Prisma migrations (bypasses connection pooling)
DIRECT_URL="postgresql://username:password@host:port/database?schema=public"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Application URL
AUTH_URL="http://localhost:3000"

# For production:
# AUTH_URL="https://your-domain.com"

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV="development"

# ============================================================================
# OPTIONAL: ERROR TRACKING (SENTRY)
# ============================================================================
# Get from: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="clinicos"

# ============================================================================
# OPTIONAL: CRON JOB AUTHENTICATION
# ============================================================================
# Secret for authenticating cron job requests (Vercel cron)
# Generate with: openssl rand -base64 32
# CRON_SECRET="your-cron-secret-here"

# ============================================================================
# OPTIONAL: RATE LIMITING
# ============================================================================
# For production with multiple servers, use Redis:
# Get from: https://upstash.com
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# For single-server deployments, memory-based rate limiting is used by default
