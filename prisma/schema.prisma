// ClinicOS Database Schema
// Production-grade healthcare practice management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

enum Role {
  FRONT_DESK
  PROVIDER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(FRONT_DESK)
  isActive     Boolean  @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  provider Provider?

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================================================
// PROVIDER MANAGEMENT
// ============================================================================

model Provider {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  title     String? // Dr., NP, PA, etc.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          ProviderProfile?
  availabilitySlots AvailabilitySlot[]
  appointments     Appointment[]
  alerts           Alert[]

  @@index([userId])
  @@index([firstName, lastName])
  @@map("providers")
}

model ProviderProfile {
  id                String   @id @default(cuid())
  providerId        String   @unique @map("provider_id")
  specialization    String?
  licenseNumber     String?  @map("license_number")
  phone             String?
  officeLocation    String?  @map("office_location")
  bio               String?
  appointmentLength Int      @default(30) @map("appointment_length") // minutes
  bufferTime        Int      @default(15) @map("buffer_time") // minutes between appointments
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_profiles")
}

// ============================================================================
// PATIENT MANAGEMENT
// ============================================================================

model Patient {
  id        String   @id @default(cuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?  @unique
  phone     String?  @unique
  dateOfBirth DateTime? @map("date_of_birth")
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  
  // Emergency Contact
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  
  // Insurance Information
  insuranceProvider String? @map("insurance_provider")
  insuranceId       String? @map("insurance_id")
  
  // Medical Information
  allergies         String?
  medications       String?
  medicalHistory    String? @map("medical_history")
  
  // Status
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  appointments Appointment[]

  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@index([dateOfBirth])
  @@map("patients")
}

// ============================================================================
// SCHEDULING SYSTEM
// ============================================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AvailabilitySlot {
  id         String     @id @default(cuid())
  providerId String     @map("provider_id")
  dayOfWeek  DayOfWeek  @map("day_of_week")
  startTime  DateTime   @map("start_time") // Time only, date will be ignored
  endTime    DateTime   @map("end_time")   // Time only, date will be ignored
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek, startTime, endTime])
  @@index([providerId])
  @@index([dayOfWeek])
  @@map("availability_slots")
}

// ============================================================================
// APPOINTMENT MANAGEMENT
// ============================================================================

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  NEW_PATIENT
  FOLLOW_UP
  CONSULTATION
  PROCEDURE
  EMERGENCY
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String            @map("patient_id")
  providerId  String            @map("provider_id")
  
  // Appointment Details
  scheduledAt DateTime          @map("scheduled_at")
  duration    Int               @default(30) // minutes
  type        AppointmentType   @default(FOLLOW_UP)
  status      AppointmentStatus @default(REQUESTED)
  
  // Appointment Information
  reason      String?
  notes       String?
  
  // Check-in/out tracking
  checkedInAt  DateTime? @map("checked_in_at")
  checkedOutAt DateTime? @map("checked_out_at")
  
  // Billing
  cost         Decimal?  @db.Decimal(10, 2)
  paid         Boolean   @default(false)
  
  // Audit fields
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  patient           Patient             @relation(fields: [patientId], references: [id])
  provider          Provider            @relation(fields: [providerId], references: [id])
  visitNote         VisitNote?
  appointmentHistory AppointmentHistory[]

  @@index([patientId])
  @@index([providerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdAt])
  @@map("appointments")
}

// ============================================================================
// CLINICAL DOCUMENTATION
// ============================================================================

model VisitNote {
  id            String   @id @default(cuid())
  appointmentId String   @unique @map("appointment_id")
  
  // Clinical Documentation
  chiefComplaint    String? @map("chief_complaint")
  historyOfPresent  String? @map("history_of_present")
  physicalExam      String? @map("physical_exam")
  assessment        String?
  plan              String?
  
  // Vital Signs
  bloodPressure     String? @map("blood_pressure")
  heartRate         Int?    @map("heart_rate")
  temperature       Decimal? @db.Decimal(4, 1) // 98.6
  respiratoryRate   Int?    @map("respiratory_rate")
  oxygenSaturation  Int?    @map("oxygen_saturation")
  weight            Decimal? @db.Decimal(5, 2) // lbs
  height            Decimal? @db.Decimal(5, 2) // inches
  
  // Prescriptions & Orders
  prescriptions     String?
  labOrders         String? @map("lab_orders")
  imagingOrders     String? @map("imaging_orders")
  referrals         String?
  
  // Follow-up
  followUpInstructions String? @map("follow_up_instructions")
  nextVisitDate        DateTime? @map("next_visit_date")
  
  // Audit fields
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("visit_notes")
}

// ============================================================================
// AUDIT & HISTORY
// ============================================================================

enum HistoryAction {
  CREATED
  UPDATED
  CANCELLED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

model AppointmentHistory {
  id            String        @id @default(cuid())
  appointmentId String        @map("appointment_id")
  action        HistoryAction
  previousValue String?       @map("previous_value")
  newValue      String?       @map("new_value")
  notes         String?
  performedBy   String?       @map("performed_by") // User ID or system
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([action])
  @@index([createdAt])
  @@map("appointment_history")
}

// ============================================================================
// ALERTS & NOTIFICATIONS
// ============================================================================

enum AlertType {
  APPOINTMENT_REMINDER
  FOLLOW_UP_DUE
  LAB_RESULTS
  PRESCRIPTION_RENEWAL
  SYSTEM_MESSAGE
  EMERGENCY
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Alert {
  id          String        @id @default(cuid())
  providerId  String?       @map("provider_id")
  type        AlertType
  priority    AlertPriority @default(MEDIUM)
  title       String
  message     String
  isRead      Boolean       @default(false) @map("is_read")
  isDismissed Boolean       @default(false) @map("is_dismissed")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}